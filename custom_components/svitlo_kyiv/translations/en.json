          "migrate": "Move the existing «Svitlo» entry",
          "group": "Add a new group"
        }
      },
      "migrate": {
        "title": "Move «{title}» (group {group})",
        "description": "Settings and entities of the old entry move to «Svitlo Kyiv» with the same entity ids. The old entry is removed afterwards.\n\nBefore that, remove the folder custom_components/svitlo (or disable the old entry) and restart Home Assistant, otherwise the entities cannot be moved."
      },
      "group": {
        "title": "Kyiv: outage group",
