{
  "title": "Svitlo Kyiv",
  "config": {
    "abort": {
      "cannot_connect": "Failed to get the Kyiv groups from Yasno. Try again later."
    },
    "step": {
      "user": {
        "title": "Svitlo Kyiv",
        "description": "The integration «Svitlo» (svitlo) of Kyiv was renamed to «Svitlo Kyiv». Move it to keep the entity ids, history and automations.",
